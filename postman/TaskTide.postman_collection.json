            }
          }
        },
        {
          "name": "Task list",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/cards?boardId={{boardId}}&status=completed&priority=high&assigneeId=me&search=landing&sort=created_at&order=desc&page=1&limit=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cards"
              ],
              "query": [
                {
                  "key": "boardId",
                  "value": "{{boardId}}",
                  "description": "Only cards on this board"
                },
                {
                  "key": "columnId",
                  "value": "{{columnId}}",
                  "description": "Only cards in this column",
                  "disabled": true
                },
                {
                  "key": "status",
                  "value": "completed",
                  "description": "completed | pending"
                },
                {
                  "key": "priority",
                  "value": "high",
                  "description": "low | medium | high"
                },
                {
                  "key": "assigneeId",
                  "value": "me",
                  "description": "A user id, or \"me\""
                },
                {
                  "key": "search",
                  "value": "landing",
                  "description": "Searches title and description (case-insensitive)"
                },
                {
                  "key": "sort",
                  "value": "created_at",
                  "description": "created_at | updated_at | priority | title"
                },
                {
                  "key": "order",
                  "value": "desc",
                  "description": "asc | desc"
                },
                {
                  "key": "page",
                  "value": "1",
                  "description": "Page number, starts at 1"
                },
                {
                  "key": "limit",
                  "value": "20",
                  "description": "Cards per page, 1 to 100"
                }
              ]
            },
            "description": "Returns your cards across all boards with filters, search, sorting and pagination."
          }
        }
